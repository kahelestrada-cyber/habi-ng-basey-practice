{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["playwright", "context7"],
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx tsc *)",
      "Bash(npx vite *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -- *)",
      "Bash(node .claude/*)",
      "Bash(python .claude/skills/ui-ux-pro-max/*)",
      "Bash(python3 .claude/skills/ui-ux-pro-max/*)",
      "Bash(py -3 .claude/skills/ui-ux-pro-max/*)",
      "mcp__playwright",
      "mcp__context7"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(vercel *)",
      "Bash(npx vercel *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-gate.mjs"],
            "timeout": 90,
            "statusMessage": "Type-checking + auto-checkpoint..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.mjs"
  }
}
